# MongoDB Atlas connection string (include the database name in the path).
MONGODB_URI=mongodb+srv://user:password@cluster0.example.mongodb.net/wemethere?retryWrites=true&w=majority&appName=Cluster0

# Secret used to sign login tokens. Use a long random string.
JWT_SECRET=change-me-to-a-long-random-string

# Optional
PORT=3000
NODE_ENV=development
